			return "icon.weapon_worldtrees_branch_i01";
		case 2503:
		case 10334:
		case 10335:
		case 10336:
			return "icon.weapon_yaksa_mace_i01";
		case 5284:
		case 10203:
		case 10204:
		case 10205:
		case 10206:
		case 10207:
			return "icon.weapon_zweihander_ls";
	}
	return Original;
}
